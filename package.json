{
  "name": "puestomap",
  "version": "1.0.0",
  "private": true,
  "description": "Panel web para localizar, inventariar y asistir en remoto los puestos de trabajo del Ayuntamiento de Mairena del Alcor",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema packages/db/prisma/schema.prisma",
    "dev": "npm run build:libs && node scripts/dev.mjs",
    "build:libs": "npm run build -w @puestomap/shared && npm run build -w @puestomap/db",
    "lint": "eslint .",
    "typecheck": "npm run build:libs && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:seed": "npm run build:libs && node --env-file-if-exists=.env packages/db/dist/seed.js",
    "db:backfill": "npm run build:libs && node --env-file-if-exists=.env packages/db/dist/backfill.js",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true
  }
}
