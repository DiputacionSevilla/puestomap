# Base de datos
POSTGRES_PASSWORD=cambiar
DATABASE_URL=postgresql://puestomap:cambiar@db:5432/puestomap

# Web
APP_URL=https://puestomap.mairenadelalcor.net
# Origen visible por el navegador al usar este Compose y URL pública del gateway.
# Local: http://localhost:3100 y ws://localhost:8181. Detrás de Nginx: la URL pública
# y, si el proxy reenvía /vnc-ws, dejar COMPOSE_GATEWAY_PUBLIC_URL vacío.
COMPOSE_APP_URL=http://localhost:3100
COMPOSE_GATEWAY_PUBLIC_URL=ws://localhost:8181
AUTH_SECRET=                       # openssl rand -base64 32 (o Node: crypto.randomBytes(32).toString('base64'))
AUTH_TRUST_HOST=true
UPLOADS_DIR=/data/uploads
ADMIN_INITIAL_USER=admin
ADMIN_INITIAL_PASSWORD=            # solo para el primer arranque (seed); cambiar tras entrar
SEED_ON_START=false                # activar solo en el primer arranque controlado de desarrollo

# Cifrado de contraseñas VNC (32 bytes en base64). NO perder: sin ella no se descifran.
VNC_ENC_KEY=

# Gateway
GATEWAY_PORT=8081
GATEWAY_JWT_SECRET=
# En producción (Nginx Proxy Manager) dejar vacío: el navegador usa /vnc-ws en el mismo host.
# En desarrollo local apuntar al gateway: ws://localhost:8081
GATEWAY_PUBLIC_URL=
ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
SESSION_IDLE_TIMEOUT_MIN=30
SESSION_MAX_HOURS=4

# Worker
WORKER_HEALTH_PORT=8082
OCS_API_URL=http://ocs.local/ocsapi/v1
OCS_API_USER=
OCS_API_PASSWORD=
OCS_SYNC_CRON=0 */2 * * *

# --- GLPI (fuente de verdad del inventario, CR-02) ---
# URL base incluyendo /glpi (sin /apirest.php). Token de API de un usuario de solo lectura.
GLPI_URL=https://glpi.example/glpi
GLPI_TOKEN=
GLPI_APP_TOKEN=
# URL pública de GLPI para los enlaces «Abrir en GLPI» (navegador del técnico)
GLPI_PUBLIC_URL=https://glpi.example/glpi
GLPI_SYNC_CRON=*/30 * * * *
# true = modo sombra: lee y cuenta, no escribe (usar hasta el corte T-80)
GLPI_SHADOW=true
# Id del lugar de GLPI que actúa como raíz (opcional)
GLPI_LOCATION_ROOT_ID=
PROBE_INTERVAL_MIN=5
PROBE_CONCURRENCY=32
PROBE_TIMEOUT_MS=1500
PROBE_ONLINE_PORTS=445,135,3389
VNC_DEFAULT_PORT=5900
VNC_ALLOWED_PORTS=5900-5909
PROBE_SCREEN_MAX=4

# CR-01 (specs/10 §9)
LASTUSER_IGNORE=system
TARGET_RESOLUTION=dns_first      # dns_first | ip_first
DNS_SUFFIX=                      # p. ej. .ayto.local (opcional)
SVG_MAX_MB=2

LOG_LEVEL=info

# Importaciones/alta manual heredadas (CR-02). Oculto por defecto: el inventario se gestiona en GLPI
LEGACY_IMPORT_ENABLED=false
